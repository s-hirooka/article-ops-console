# Copy to .env for local dev (git-ignored). In the cloud these are set as
# Render / GitHub Actions environment variables.

# --- Google Ads (keyword volume) -------------------------------------------------
# Reuse the existing KeywordInsightService creds without copying them here:
GOOGLE_ADS_DOTENV=G:\KeywordInsightService\.env
# ...or set them directly:
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_OAUTH2_CLIENT_ID=
# GOOGLE_ADS_OAUTH2_CLIENT_SECRET=
# GOOGLE_ADS_OAUTH2_REFRESH_TOKEN=
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# GOOGLE_ADS_DEFAULT_CUSTOMER_ID=
# GOOGLE_ADS_LANGUAGE_ID=1005
# GOOGLE_ADS_GEO_TARGET_IDS=2392

# --- Google OAuth (server-side, Search Console + Ads) ---------------------------
# A *Web application* OAuth client. Defaults to the Ads OAuth client if unset.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/oauth/google/callback

# --- Secrets at rest -----------------------------------------------------------
# Generate: python -c "from app.security.crypto import generate_key; print(generate_key())"
APP_ENCRYPTION_KEY=

# --- Database (P2+) ----------------------------------------------------------
# DATABASE_URL=postgresql://...

# --- Eyecatch fonts (optional override; defaults to app/assets/fonts) ---------
# EYECATCH_FONT_DIR=
